# Neurovia frontend (Vite). Copy to frontend/.env and fill in only what you use.

# API origin. The Vite dev server defaults to http://localhost:5173.
VITE_API_BASE_URL=http://localhost:5000
# Leave unset in production: the deployed site serves the API at /api on the same domain.

# Optional. Leave blank to hide Stripe checkout.
VITE_STRIPE_PUBLIC_KEY=

# Optional Google OAuth web client ID.
# VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
